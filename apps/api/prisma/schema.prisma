// LedgerIQ schema (Slice 1, PR c). See docs/ledger.md and ADRs 0001-0004.
//
//   Organization ──< Membership >── User
//        │
//        ├──< Account          chart of accounts (system accounts keyed by systemKey)
//        ├──< SalesChannel     product-brand dimension on lines
//        ├──< JournalEntry ──< JournalLine      THE ledger (integer minor units)
//        ├──< Payout           processor payout expectations (matching lands in Slice 2)
//        └──< AuditLog         every mutation, with before/after
//
// Money: BIGINT minor units, never floats (ADR 0002).
// Dates: DATE columns, interpreted in Organization.timezone (ADR 0004).
// Invariants the database enforces (prisma/migrations/*/migration.sql, hand-written part):
//   - each journal line has exactly one positive side (debit xor credit)
//   - a POSTED entry's debits equal its credits (deferred constraint trigger)
//   - locked entries and their lines cannot be updated or deleted
//   - on a POSTED entry, bank-side lines and the entry date cannot change

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  fullName        String    @map("full_name")
  passwordHash    String    @map("password_hash")
  /// Mongo _id of the user this row was migrated from; null for native signups.
  legacyMongoId   String?   @unique @map("legacy_mongo_id")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// ISO 4217. One currency per organization at launch; lines carry it too so multi-currency can be added later.
  currency  String   @default("USD") @db.Char(3)
  /// IANA timezone used for "today", "last 30 days", and the weekly brief's Monday.
  timezone  String   @default("America/New_York")
  /// Per-organization feature flags, e.g. { "moneyBrief": false }. Absent = the default in services/ai/brief.ts.
  featureFlags Json  @default("{}") @map("feature_flags")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  accounts      Account[]
  salesChannels SalesChannel[]
  entries       JournalEntry[]
  lines         JournalLine[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  bankAccounts  BankAccount[]
  bankConnections  BankConnection[]
  bankTransactions BankTransaction[]
  imports       Import[]
  rules         CategoryRule[]
  metricsSnapshots MetricsSnapshot[]
  aiInsights       AiInsight[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER
  ADMIN
  BOOKKEEPER
  ACCOUNTANT
  VIEWER
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Chart of accounts
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  type           AccountType
  name           String
  /// Optional numeric code shown to accountants (1000, 4000...). Unique per org when present.
  code           String?
  /// Stable key for accounts the system needs to find: "uncategorized", "opening_balance",
  /// "sales", "cogs", "processor_fees", "clearing:stripe", "clearing:shopify_payments", ...
  systemKey      String?     @map("system_key")
  isArchived     Boolean     @default(false) @map("is_archived")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]
  bankAccounts BankAccount[]
  rules        CategoryRule[]

  @@unique([organizationId, systemKey])
  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Product-brand dimension
// ---------------------------------------------------------------------------

enum SalesChannelKind {
  SHOPIFY
  TIKTOK_SHOP
  INSTAGRAM
  ETSY
  AMAZON
  WEBSITE
  OTHER
}

model SalesChannel {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  kind           SalesChannelKind
  name           String
  /// Fee model the payout matcher uses, e.g. { "percent": 2.9, "fixedMinor": 30 }. Optional until Slice 2.
  feeModel       Json?            @map("fee_model")
  isArchived     Boolean          @default(false) @map("is_archived")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]
  payouts      Payout[]
  rules        CategoryRule[]

  @@unique([organizationId, name])
  @@map("sales_channels")
}

// ---------------------------------------------------------------------------
// The ledger
// ---------------------------------------------------------------------------

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
  DISCARDED
}

enum EntrySource {
  MANUAL
  BANK
  INVOICE
  BILL
  PAYOUT
  ORDER
  PAYROLL
  OPENING
  MIGRATION
}

model JournalEntry {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  /// Calendar date in the organization's timezone.
  date            DateTime    @db.Date
  memo            String      @default("")
  status          EntryStatus @default(POSTED)
  /// Locked = reconciled or period closed. Immutable; corrections are reversing entries (ADR 0004).
  locked          Boolean     @default(false)
  source          EntrySource
  /// Idempotency key from the source system: bank transaction id, Mongo _id, invoice id...
  externalRef     String?     @map("external_ref")
  /// Set on the reversing entry: the entry it reverses.
  reversesEntryId String?     @unique @map("reverses_entry_id") @db.Uuid
  /// Optimistic concurrency for in-place edits (two tabs recategorizing the same row).
  version         Int         @default(1)
  createdById     String?     @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]
  reverses     JournalEntry? @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")

  @@unique([organizationId, source, externalRef])
  @@index([organizationId, date(sort: Desc), id])
  @@index([organizationId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid()) @db.Uuid
  entryId        String  @map("entry_id") @db.Uuid
  /// Denormalized for org-scoped reporting queries and the balance trigger.
  organizationId String  @map("organization_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  /// Exactly one of debit/credit is positive (DB CHECK). Sign lives in the side, not the number.
  debitMinor     BigInt  @default(0) @map("debit_minor")
  creditMinor    BigInt  @default(0) @map("credit_minor")
  currency       String  @db.Char(3)
  /// Sales-channel dimension for revenue, fees, ad spend, COGS, refunds.
  channelId      String? @map("channel_id") @db.Uuid
  /// The line that mirrors a bank/processor row. Never edited after import; recategorization touches the other side.
  isBankSide     Boolean @default(false) @map("is_bank_side")
  memo           String?
  position       Int     @default(0)

  entry        JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  channel      SalesChannel? @relation(fields: [channelId], references: [id])

  @@index([entryId])
  @@index([organizationId, accountId])
  @@index([organizationId, channelId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Payouts (model now; matching in Slice 2)
// ---------------------------------------------------------------------------

enum PayoutStatus {
  PENDING
  MATCHED
  UNMATCHED
  VARIANCE
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  channelId        String?      @map("channel_id") @db.Uuid
  /// "stripe", "shopify_payments", "paypal", "square", ...
  processor        String
  externalId       String       @map("external_id")
  grossMinor       BigInt       @map("gross_minor")
  feesMinor        BigInt       @map("fees_minor")
  refundsMinor     BigInt       @default(0) @map("refunds_minor")
  adjustmentsMinor BigInt       @default(0) @map("adjustments_minor")
  /// gross - fees - refunds + adjustments: the deposit the bank should show.
  expectedNetMinor BigInt       @map("expected_net_minor")
  currency         String       @db.Char(3)
  arrivalDate      DateTime     @map("arrival_date") @db.Date
  status           PayoutStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      SalesChannel? @relation(fields: [channelId], references: [id])

  @@unique([organizationId, processor, externalId])
  @@index([organizationId, status, arrivalDate])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Metrics (plan E1 / CEO finding 7.1)
// ---------------------------------------------------------------------------

/// One computed metrics payload per organization per calendar day. `fingerprint`
/// is a cheap digest of the ledger (entry count + latest update) so a stale
/// snapshot is recomputed on read instead of invalidated by every write.
model MetricsSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  asOf           DateTime @map("as_of") @db.Date
  fingerprint    String
  /// MetricsView (services/metrics/metrics.ts): every metric with id, value, unit, display, window.
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, asOf])
  @@map("metrics_snapshots")
}

// ---------------------------------------------------------------------------
// AI insights (plan E8 / Phase 4; CEO findings 4.1, 8.1)
// ---------------------------------------------------------------------------

enum InsightKind {
  WEEKLY_BRIEF
}

enum InsightStatus {
  /// Narrated by the model and grounding-validated.
  GENERATED
  /// Deterministic summary shown instead (model off, refused, malformed, or ungrounded twice).
  DEGRADED
}

/// One brief per organization per period. Stores the exact input snapshot, the
/// raw model response, and the validated output so a wrong brief can be
/// replayed weeks later.
model AiInsight {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  kind           InsightKind   @default(WEEKLY_BRIEF)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  status         InsightStatus
  /// Model id that narrated it, or null when degraded / model off.
  model          String?
  promptVersion  String        @map("prompt_version")
  /// BriefInput: metrics view + anomalies as handed to the model.
  inputSnapshot  Json          @map("input_snapshot")
  rawResponse    String?       @map("raw_response")
  /// MoneyBrief (services/ai/schema.ts).
  brief          Json
  /// Why the model output was rejected, when it was.
  degradedReason String?       @map("degraded_reason")
  requestId      String?       @map("request_id")
  regenerations  Int           @default(0)
  emailedAt      DateTime?     @map("emailed_at") @db.Timestamptz(3)
  /// Set the first time a member opens it (the first-open reveal).
  firstOpenedAt  DateTime?     @map("first_opened_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, periodStart])
  @@map("ai_insights")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// "entry.post", "entry.reverse", "entry.recategorize", "entry.lock", "account.create", ...
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Bank accounts, CSV imports, categorization rules (Slice 1, lane 1.4a)
// ---------------------------------------------------------------------------

enum BankAccountKind {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  OTHER
}

model BankAccount {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  kind           BankAccountKind @default(CHECKING)
  /// The ledger account this bank account posts to (asset, or liability for credit cards). systemKey "bank:<id>".
  accountId      String          @map("account_id") @db.Uuid
  currency       String          @db.Char(3)
  /// Last four digits or similar, display only.
  mask           String?
  /// Set when the account comes from a feed (plan 1.4b): the connection and the provider's account id.
  connectionId   String?         @map("connection_id") @db.Uuid
  externalId     String?         @map("external_id")
  isArchived     Boolean         @default(false) @map("is_archived")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account         @relation(fields: [accountId], references: [id])
  connection   BankConnection? @relation(fields: [connectionId], references: [id])
  imports      Import[]
  transactions BankTransaction[]

  @@unique([organizationId, name])
  @@unique([connectionId, externalId])
  @@map("bank_accounts")
}

// ---------------------------------------------------------------------------
// Bank feeds (plan 1.4b: Plaid sandbox; eng review F2, F17)
// ---------------------------------------------------------------------------

enum BankConnectionStatus {
  ACTIVE
  /// The bank wants the user to log in again (ITEM_LOGIN_REQUIRED); shown as a "Reconnect" banner.
  NEEDS_REAUTH
  DISCONNECTED
}

/// One connected institution (a Plaid Item). The access token is AES-256-GCM
/// encrypted with the key named by `keyId`; rows re-encrypt lazily on read
/// after a key rotation (eng review F17).
model BankConnection {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  /// "plaid" or "fixture" (the offline provider used in development and tests).
  provider              String
  providerItemId        String               @map("provider_item_id")
  institutionId         String?              @map("institution_id")
  institutionName       String               @map("institution_name")
  accessTokenCiphertext String               @map("access_token_ciphertext")
  keyId                 String               @map("key_id")
  status                BankConnectionStatus @default(ACTIVE)
  /// /transactions/sync cursor, persisted only after the page it came with is committed.
  syncCursor            String?              @map("sync_cursor")
  lastSyncedAt          DateTime?            @map("last_synced_at") @db.Timestamptz(3)
  lastError             String?              @map("last_error")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     BankAccount[]
  transactions BankTransaction[]

  @@unique([provider, providerItemId])
  @@index([organizationId])
  @@map("bank_connections")
}

enum BankTransactionStatus {
  ACTIVE
  /// The provider removed it (or a pending transaction posted under a new id); its entry is reversed.
  REMOVED
}

/// A raw feed row and the journal entry it produced. Idempotent by the
/// provider's transaction id; `modified` rows are reversed and re-posted.
model BankTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  connectionId      String                @map("connection_id") @db.Uuid
  bankAccountId     String                @map("bank_account_id") @db.Uuid
  externalId        String                @map("external_id")
  /// The pending transaction this posted one replaces (Plaid `pending_transaction_id`).
  pendingExternalId String?               @map("pending_external_id")
  date              DateTime              @db.Date
  /// Signed: positive = money in, negative = money out (the bank's perspective).
  amountMinor       BigInt                @map("amount_minor")
  description       String
  pending           Boolean               @default(false)
  status            BankTransactionStatus @default(ACTIVE)
  /// The live journal entry for this row (null after removal).
  entryId           String?               @unique @map("entry_id") @db.Uuid
  /// Bumped on every re-post (modified rows); part of the entry's externalRef so history stays unique.
  revision          Int                   @default(0)
  raw               Json
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount    @relation(fields: [bankAccountId], references: [id])

  @@unique([connectionId, externalId])
  @@index([organizationId, bankAccountId, date])
  @@map("bank_transactions")
}

enum ImportStatus {
  UPLOADED
  MAPPED
  COMMITTING
  COMMITTED
  FAILED
}

/// One uploaded statement. Rows are parsed once with the chosen mapping, then
/// committed in batches of 500 so a failure mid-file leaves earlier batches in
/// place and the rest resumable (eng review F16).
model Import {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  bankAccountId  String       @map("bank_account_id") @db.Uuid
  filename       String
  status         ImportStatus @default(UPLOADED)
  /// Header names as found in the file.
  columns        Json
  /// The mapping the user confirmed: { dateColumn, descriptionColumn, amountColumn | debitColumn + creditColumn, dateFormat, signConvention }.
  mapping        Json?
  rowCount       Int          @default(0) @map("row_count")
  newCount       Int          @default(0) @map("new_count")
  duplicateCount Int          @default(0) @map("duplicate_count")
  invalidCount   Int          @default(0) @map("invalid_count")
  importedCount  Int          @default(0) @map("imported_count")
  error          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  rows         ImportRow[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("imports")
}

enum ImportRowStatus {
  PENDING
  NEW
  DUPLICATE
  INVALID
  SKIPPED
  IMPORTED
}

model ImportRow {
  id             String          @id @default(uuid()) @db.Uuid
  importId       String          @map("import_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  index          Int
  /// The raw cells, keyed by header, exactly as read.
  raw            Json
  date           DateTime?       @db.Date
  description    String?
  /// Signed minor units after the sign convention: positive = money in.
  amountMinor    BigInt?         @map("amount_minor")
  /// Dedupe key (eng review F6): bank account + date + amount + normalized description + occurrence index.
  dedupeHash     String?         @map("dedupe_hash")
  status         ImportRowStatus @default(PENDING)
  /// Why the row is INVALID, in words the user can act on.
  problem        String?
  /// The entry this row created (IMPORTED rows).
  entryId        String?         @map("entry_id") @db.Uuid

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, index])
  @@index([organizationId, dedupeHash])
  @@map("import_rows")
}

enum RuleMatch {
  CONTAINS
  EXACT
  REGEX
}

/// "Always categorize X this way." Applied on import (first match by priority)
/// and, optionally, to existing uncategorized rows when created.
model CategoryRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  match          RuleMatch @default(CONTAINS)
  /// Compared case-insensitively against the normalized description.
  pattern        String
  accountId      String    @map("account_id") @db.Uuid
  channelId      String?   @map("channel_id") @db.Uuid
  priority       Int       @default(100)
  hitCount       Int       @default(0) @map("hit_count")
  isArchived     Boolean   @default(false) @map("is_archived")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  channel      SalesChannel? @relation(fields: [channelId], references: [id])

  @@index([organizationId, priority])
  @@map("category_rules")
}

// ---------------------------------------------------------------------------
// Sessions and one-time tokens (Slice 1, lane 1.1)
// ---------------------------------------------------------------------------

/// Opaque refresh tokens, stored hashed. One row per issued token; rotation
/// creates a new row in the same family and marks the old one used. A used
/// token presented again outside the two-tab grace window is reuse: the
/// whole family is revoked (eng review F10).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// One-time tokens for email links, stored hashed, single use, short-lived.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}
