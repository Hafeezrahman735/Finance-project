# Required
MONGO_URL=            # MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/ledgeriq (Atlas: https://cloud.mongodb.com)
JWT_SECRET=           # Any long random string. Generate with: openssl rand -hex 32

# Optional
PORT=8000             # The web app expects 8000 (apps/web/vite.config.js proxies /api here). Default: 8000
CLIENT_URL=           # CORS allowlist for a separately hosted web app. Leave unset when using the Vite proxy. Default: none (same-site only)
LOG_LEVEL=info        # pino level: trace | debug | info | warn | error. Default: info
JWT_EXPIRES_IN=1h     # Access token lifetime. Default: 1h
