# Required
DATABASE_URL=postgresql://ledgeriq:ledgeriq@localhost:5432/ledgeriq   # Postgres for the ledger. Local install: docs/setup.md#2-postgres. Hosted free tier: Neon (https://neon.tech)
JWT_SECRET=           # Any long random string. Generate with: openssl rand -hex 32

# Optional
MONGO_URL=            # Only for scripts/migrate-mongo-to-pg.ts (one-time import of Expense Tracker data); the API does not use it
TEST_DATABASE_URL=postgresql://ledgeriq:ledgeriq@localhost:5432/ledgeriq_test   # Separate database for `npm run test`; the suite TRUNCATES it
PORT=8000             # The web app expects 8000 (apps/web/vite.config.js proxies /api here). Default: 8000
CLIENT_URL=           # CORS allowlist for a separately hosted web app. Leave unset when using the Vite proxy. Default: none (same-site only)
LOG_LEVEL=info        # pino level: trace | debug | info | warn | error. Default: info
JWT_EXPIRES_IN=15m    # Access token lifetime; refresh tokens (httpOnly cookie) keep you signed in. Default: 15m
REFRESH_TOKEN_DAYS=30 # Refresh token lifetime. Default: 30
APP_URL=http://localhost:5173   # Where password-reset and verification links point. Default: http://localhost:5173
RESEND_API_KEY=       # Optional (https://resend.com, free tier 3,000/month). Without it, emails are printed to the API log with the link.
EMAIL_FROM=LedgerIQ <onboarding@resend.dev>   # Sender; use your verified domain in production
PLAID_CLIENT_ID=      # Optional (https://dashboard.plaid.com, free sandbox). Without it "Connect a bank" uses the built-in fixture bank (offline, deterministic).
PLAID_SECRET=         # The sandbox secret from the same dashboard page
PLAID_ENV=sandbox     # sandbox | production | fixture. Default: sandbox when the keys are set, otherwise fixture
TOKEN_ENCRYPTION_KEY= # 64 hex chars (openssl rand -hex 32) for bank access tokens at rest. Required with Plaid in production; derived from JWT_SECRET in development
TOKEN_ENCRYPTION_KEY_PREVIOUS=   # Comma-separated old keys during a rotation; rows re-encrypt on read
ANTHROPIC_API_KEY=    # Optional (https://console.anthropic.com). Without it the weekly brief is the deterministic summary, no narration.
AI_PROVIDER=          # anthropic | recorded | off. Default: anthropic when ANTHROPIC_API_KEY is set, otherwise off. recorded replays fixtures/cassettes/brief (CI).
AI_MODEL=claude-opus-5   # Model that narrates the brief. Default: claude-opus-5
TRUST_PROXY=          # Set to 1 behind a load balancer / platform proxy so rate limits see the client IP. Default: unset
AUTH_RATE_LIMIT=true  # Per-IP / per-email limits on login, register, refresh, reset, verification. Default: true. Behind a proxy see docs/setup.md#rate-limits
BRIEF_RECORD=false    # With AI_PROVIDER=anthropic, also save each live response as a cassette for recorded runs. Default: false
